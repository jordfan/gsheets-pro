{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__.*__sheets_[a-z_]+$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/first-call.mjs\"",
            "timeout": 10,
            "statusMessage": "Loading the gsheets-pro house rules"
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.mjs\"",
            "timeout": 10,
            "statusMessage": "Checking the spreadsheet registry"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__.*__sheets_[a-z_]+$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/after-write.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
